{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syn-studios.local/schemas/artifact-blueprint.schema.json",
  "title": "Syn Studios artifact blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "blueprint_id", "archetype", "name", "artifact_type", "foundation_lineage", "producer", "purpose", "medium", "lifecycle", "authority", "source_boundary", "footprint", "handling_history", "complexity_layers", "prohibited", "proof_gates"],
  "$defs": {
    "nonemptyStringArray": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "proofGate": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "applicable", "procedure"],
      "properties": {
        "category": {"enum": ["core_integrity", "render", "metadata", "computational", "provenance", "leakage", "authority_separation", "anti_filler"]},
        "applicable": {"type": "boolean"},
        "procedure": {"type": "string", "minLength": 8},
        "not_applicable_rationale": {"type": "string", "minLength": 8}
      },
      "allOf": [{"if": {"properties": {"applicable": {"const": false}}}, "then": {"required": ["not_applicable_rationale"]}, "else": {"not": {"required": ["not_applicable_rationale"]}}}]
    }
  },
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "blueprint_id": {"type": "string", "pattern": "^BP-[0-9]{4}$"},
    "archetype": {"enum": ["close_workbook", "internal_decision_memo", "email_chain", "executed_agreement", "mixed_package", "policy_procedure", "system_export", "operational_note", "external_notice_approval"]},
    "name": {"type": "string", "minLength": 3},
    "artifact_type": {"enum": ["docx", "xlsx", "pdf", "eml", "csv", "mixed_package"]},
    "foundation_lineage": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["card_id", "card_sha256", "reviewed_source_sha256", "use_mode", "patterns_used", "prohibited_content_acknowledged", "transformation_boundary"],
        "properties": {
          "card_id": {"type": "string", "pattern": "^FOUND-[0-9]{4}$"},
          "card_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "reviewed_source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "use_mode": {"enum": ["reviewed_pattern", "rejected_pattern_only"]},
          "patterns_used": {"$ref": "#/$defs/nonemptyStringArray"},
          "prohibited_content_acknowledged": {"const": true},
          "transformation_boundary": {"type": "string", "minLength": 12},
          "independent_review": {
            "type": "object", "additionalProperties": false,
            "required": ["reviewer", "decision", "scope"],
            "properties": {
              "reviewer": {"type": "string", "minLength": 3},
              "decision": {"const": "pattern_only_approved"},
              "scope": {"type": "string", "minLength": 12}
            }
          }
        },
        "allOf": [{"if": {"properties": {"use_mode": {"const": "rejected_pattern_only"}}}, "then": {"required": ["independent_review"]}, "else": {"not": {"required": ["independent_review"]}}}]
      }
    },
    "producer": {"type": "string", "minLength": 3},
    "purpose": {"type": "string", "minLength": 10},
    "medium": {"type": "string", "minLength": 3},
    "lifecycle": {"type": "string", "minLength": 3},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_class", "governing_scope", "non_governing_scope"],
      "properties": {
        "primary_class": {"enum": ["authoritative", "supporting", "contextual", "superseded", "question-only", "incidental", "mixed"]},
        "governing_scope": {"type": "string", "minLength": 8},
        "non_governing_scope": {"type": "string", "minLength": 8}
      }
    },
    "source_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["authorized_inputs", "excluded_inputs", "conflict_resolution"],
      "properties": {
        "authorized_inputs": {"$ref": "#/$defs/nonemptyStringArray"},
        "excluded_inputs": {"$ref": "#/$defs/nonemptyStringArray"},
        "conflict_resolution": {"type": "string", "minLength": 12}
      }
    },
    "footprint": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "natural_depth", "source_owned_rationale"],
      "properties": {
        "target": {"type": "string", "minLength": 3},
        "natural_depth": {"$ref": "#/$defs/nonemptyStringArray"},
        "source_owned_rationale": {"type": "string", "minLength": 20}
      }
    },
    "handling_history": {
      "type": "object", "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"enum": ["present", "none"]}, "sequence": {"$ref": "#/$defs/nonemptyStringArray"}, "justification": {"type": "string", "minLength": 12}},
      "allOf": [{"if": {"properties": {"mode": {"const": "present"}}}, "then": {"required": ["sequence"], "not": {"required": ["justification"]}}, "else": {"required": ["justification"], "not": {"required": ["sequence"]}}}]
    },
    "complexity_layers": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["layer", "features"],
        "properties": {"layer": {"enum": ["core", "operational_depth", "adjacent_context", "working_residue", "handling_history"]}, "features": {"$ref": "#/$defs/nonemptyStringArray"}}
      }
    },
    "prohibited": {"$ref": "#/$defs/nonemptyStringArray"},
    "proof_gates": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/proofGate"}}
  }
}
