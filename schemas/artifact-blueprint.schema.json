{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syn-studios.local/schemas/artifact-blueprint.schema.json",
  "title": "Syn Studios artifact blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "blueprint_id",
    "name",
    "artifact_type",
    "producer",
    "purpose",
    "medium",
    "lifecycle",
    "authority",
    "footprint",
    "complexity_layers",
    "prohibited",
    "proof_gates"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "blueprint_id": {"type": "string", "pattern": "^BP-[0-9]{4}$"},
    "name": {"type": "string", "minLength": 3},
    "artifact_type": {"enum": ["docx", "xlsx", "pdf", "eml", "csv", "mixed_package"]},
    "producer": {"type": "string", "minLength": 3},
    "purpose": {"type": "string", "minLength": 10},
    "medium": {"type": "string", "minLength": 3},
    "lifecycle": {"type": "string", "minLength": 3},
    "authority": {"enum": ["authoritative", "supporting", "contextual", "superseded", "question-only", "incidental", "mixed"]},
    "footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "natural_depth"],
      "properties": {
        "target": {"type": "string", "minLength": 3},
        "natural_depth": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "complexity_layers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "features"],
        "properties": {
          "layer": {"enum": ["core", "operational_depth", "adjacent_context", "working_residue", "handling_history"]},
          "features": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "prohibited": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "proof_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}

