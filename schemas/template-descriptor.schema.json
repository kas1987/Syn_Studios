{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syn-studios.local/schemas/template-descriptor.schema.json",
  "title": "Syn Studios template descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_id", "version", "artifact_type", "blueprint_id", "blueprint_sha256", "native_assets", "supported_consumers", "capabilities"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "asset": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "template_id": {"type": "string", "pattern": "^TMPL-[0-9]{4}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "artifact_type": {"enum": ["docx", "xlsx", "pdf", "eml", "csv", "mixed_package"]},
    "blueprint_id": {"type": "string", "pattern": "^BP-[0-9]{4}$"},
    "blueprint_sha256": {"$ref": "#/$defs/sha256"},
    "native_assets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/asset"}},
    "supported_consumers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
