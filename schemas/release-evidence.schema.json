{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syn-studios.local/schemas/release-evidence.schema.json",
  "title": "Syn Studios typed template-release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "record_type", "release_id", "template_id", "version", "descriptor_sha256", "native_asset_sha256s", "verdict", "actor", "summary"],
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "pattern": "^EVID-[A-Z0-9-]{4,64}$"},
    "record_type": {"enum": ["sanitization", "terra_review", "sol_review", "conductor_approval", "technical_validation"]},
    "release_id": {"type": "string", "pattern": "^REL-[0-9]{4}$"},
    "template_id": {"type": "string", "pattern": "^TMPL-[0-9]{4}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "native_asset_sha256s": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "verdict": {"enum": ["SANITIZATION_PASS", "USABILITY_PASS", "INTEGRITY_PASS", "APPROVED", "VALIDATION_PASS", "VALIDATION_NOT_APPLICABLE"]},
    "actor": {"type": "string", "minLength": 3},
    "categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["core_integrity", "render", "metadata", "computational", "provenance", "leakage", "authority_separation", "anti_filler"]}},
    "procedures": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "core_integrity": {"type": "string", "minLength": 8}, "render": {"type": "string", "minLength": 8},
        "metadata": {"type": "string", "minLength": 8}, "computational": {"type": "string", "minLength": 8},
        "provenance": {"type": "string", "minLength": 8}, "leakage": {"type": "string", "minLength": 8},
        "authority_separation": {"type": "string", "minLength": 8}, "anti_filler": {"type": "string", "minLength": 8}
      }
    },
    "summary": {"type": "string", "minLength": 12}
  },
  "allOf": [
    {"if": {"properties": {"record_type": {"const": "sanitization"}}}, "then": {"properties": {"verdict": {"const": "SANITIZATION_PASS"}}, "not": {"anyOf": [{"required": ["categories"]}, {"required": ["procedures"]}]}}},
    {"if": {"properties": {"record_type": {"const": "terra_review"}}}, "then": {"properties": {"verdict": {"const": "USABILITY_PASS"}}, "not": {"anyOf": [{"required": ["categories"]}, {"required": ["procedures"]}]}}},
    {"if": {"properties": {"record_type": {"const": "sol_review"}}}, "then": {"properties": {"verdict": {"const": "INTEGRITY_PASS"}}, "not": {"anyOf": [{"required": ["categories"]}, {"required": ["procedures"]}]}}},
    {"if": {"properties": {"record_type": {"const": "conductor_approval"}}}, "then": {"properties": {"verdict": {"const": "APPROVED"}}, "not": {"anyOf": [{"required": ["categories"]}, {"required": ["procedures"]}]}}},
    {"if": {"properties": {"record_type": {"const": "technical_validation"}}}, "then": {"properties": {"verdict": {"enum": ["VALIDATION_PASS", "VALIDATION_NOT_APPLICABLE"]}}, "required": ["categories", "procedures"]}}
  ]
}
