{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syn-studios.local/schemas/workbook-recalculation-proof.schema.json",
  "title": "Syn Studios workbook recalculation proof",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proof_type", "proof_id", "release_id", "template_id", "version", "category", "descriptor_sha256", "source_workbook", "engine", "execution", "formula_evidence", "verdict"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "proof_type": {"const": "workbook_recalculation_result"},
    "proof_id": {"type": "string", "pattern": "^RECALC-REL-[0-9]{4}$"},
    "release_id": {"type": "string", "pattern": "^REL-[0-9]{4}$"},
    "template_id": {"type": "string", "pattern": "^TMPL-[0-9]{4}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "category": {"const": "computational"},
    "descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "source_workbook": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "engine": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {"name": {"const": "LibreOffice Calc"}, "version": {"type": "string", "pattern": "^LibreOffice "}}
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "output_format", "cache_reset", "cleared_formula_cache_count", "prepared_cached_formula_count", "source_before_sha256", "source_after_sha256", "source_unchanged"],
      "properties": {
        "mode": {"const": "headless_cache_stripped_copy"},
        "output_format": {"const": "xlsx"},
        "cache_reset": {"const": "remove_all_formula_cached_values"},
        "cleared_formula_cache_count": {"type": "integer", "minimum": 1},
        "prepared_cached_formula_count": {"const": 0},
        "source_before_sha256": {"$ref": "#/$defs/sha256"},
        "source_after_sha256": {"$ref": "#/$defs/sha256"},
        "source_unchanged": {"const": true}
      }
    },
    "formula_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["formula_count", "cached_formula_count", "formula_sheets", "error_count", "control_cells", "formula_results", "formula_structure_sha256", "formula_results_sha256"],
      "properties": {
        "formula_count": {"type": "integer", "minimum": 1},
        "cached_formula_count": {"type": "integer", "minimum": 1},
        "formula_sheets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "error_count": {"const": 0},
        "control_cells": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["PASS", "NOT READY", "NOT APPLICABLE"]}},
        "formula_results": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["sheet", "cell", "formula", "formula_attributes", "cell_type", "cached_value", "cache_present"],
            "properties": {
              "sheet": {"type": "string", "minLength": 1},
              "cell": {"type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]*$"},
              "formula": {"type": "string"},
              "formula_attributes": {"type": "object", "additionalProperties": {"type": "string"}},
              "cell_type": {"type": "string", "minLength": 1},
              "cached_value": {"type": "string"},
              "cache_present": {"const": true}
            }
          }
        },
        "formula_structure_sha256": {"$ref": "#/$defs/sha256"},
        "formula_results_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "verdict": {"const": "RECALCULATION_PASS"}
  }
}
