{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syn-studios.local/schemas/foundation-card.schema.json",
  "title": "Syn Studios foundation card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "card_id",
    "status",
    "artifact_type",
    "source",
    "assessment",
    "reuse"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "card_id": {"type": "string", "pattern": "^FOUND-[0-9]{4}$"},
    "status": {"enum": ["candidate", "reviewed", "rejected", "template_ready"]},
    "artifact_type": {"enum": ["docx", "xlsx", "pdf", "eml", "csv", "mixed_package"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "sha256", "synthetic_authorized"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "synthetic_authorized": {"const": true}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strengths", "defects", "confidence_limits"],
      "properties": {
        "strengths": {"type": "array", "items": {"type": "string"}},
        "defects": {"type": "array", "items": {"type": "string"}},
        "confidence_limits": {"type": "array", "items": {"type": "string"}}
      }
    },
    "reuse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patterns", "prohibited_content", "sanitization", "proof_gate"],
      "properties": {
        "patterns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "prohibited_content": {"type": "array", "items": {"type": "string"}},
        "sanitization": {"type": "array", "items": {"type": "string"}},
        "proof_gate": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}

