{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syn-studios.local/schemas/template-release.schema.json",
  "title": "Syn Studios template release record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "template_id", "version", "status", "descriptor", "native_assets", "blueprint", "build", "sanitization", "reviews", "conductor_approval", "evidence"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "boundPath": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "evidenceReference": {
      "type": "object", "additionalProperties": false, "required": ["record_path", "record_sha256"],
      "properties": {"record_path": {"type": "string", "minLength": 1}, "record_sha256": {"$ref": "#/$defs/sha256"}}
    }
  },
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "release_id": {"type": "string", "pattern": "^REL-[0-9]{4}$"},
    "template_id": {"type": "string", "pattern": "^TMPL-[0-9]{4}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["released", "deprecated", "withdrawn"]},
    "descriptor": {"$ref": "#/$defs/boundPath"},
    "native_assets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/boundPath"}},
    "blueprint": {
      "type": "object", "additionalProperties": false, "required": ["blueprint_id", "path", "sha256"],
      "properties": {"blueprint_id": {"type": "string", "pattern": "^BP-[0-9]{4}$"}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "build": {"$ref": "#/$defs/evidenceReference"},
    "sanitization": {
      "type": "object", "additionalProperties": false, "required": ["evidence", "foundation_card_ids"],
      "properties": {
        "evidence": {"$ref": "#/$defs/evidenceReference"},
        "foundation_card_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FOUND-[0-9]{4}$"}}
      }
    },
    "reviews": {
      "type": "object", "additionalProperties": false, "required": ["terra", "sol"],
      "properties": {"terra": {"$ref": "#/$defs/evidenceReference"}, "sol": {"$ref": "#/$defs/evidenceReference"}}
    },
    "conductor_approval": {"$ref": "#/$defs/evidenceReference"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["core_integrity", "render", "metadata", "computational", "provenance", "leakage", "authority_separation", "anti_filler"],
      "properties": {
        "core_integrity": {"$ref": "#/$defs/evidenceReference"},
        "render": {"$ref": "#/$defs/evidenceReference"},
        "metadata": {"$ref": "#/$defs/evidenceReference"},
        "computational": {"$ref": "#/$defs/evidenceReference"},
        "provenance": {"$ref": "#/$defs/evidenceReference"},
        "leakage": {"$ref": "#/$defs/evidenceReference"},
        "authority_separation": {"$ref": "#/$defs/evidenceReference"},
        "anti_filler": {"$ref": "#/$defs/evidenceReference"}
      }
    }
  }
}
