{
  "schema_version": "1.0.0",
  "template_id": "TMPL-0001",
  "version": "1.0.0",
  "name": "Internal close and reconciliation workbook",
  "release_status": "candidate",
  "artifact_type": "xlsx",
  "blueprint_id": "BP-0001",
  "native_assets": [
    {
      "path": "library/templates/TMPL-0001/1.0.0/internal-close-reconciliation.xlsx",
      "media_type": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "sha256": "26f97baff5b2ff007d18f3b47a11736f9362a91462ce256a7126a82f477a4fa5"
    }
  ],
  "producer": {"role": "senior accountant", "review_role": "controller", "department": "finance"},
  "purpose": "Reconcile authorized source activity to a ledger balance, document exceptions, and prepare supported close entries.",
  "lifecycle": "internal working copy through reviewed close file",
  "authority": "supporting",
  "slots": ["organization_name", "close_period_end", "preparer_role", "reviewer_role"],
  "slot_contract": {
    "token_format": "{{slot_name}}",
    "required": true,
    "instantiated_artifact_policy": "reject_if_any_declared_or_double_brace_token_remains",
    "value_source": "authorized world facts or explicit role assignment only"
  },
  "population_contract": {
    "mode": "bounded_native_tables",
    "capacity_change_policy": "reject_and_rebuild_with_fresh_formula_and_render_evidence",
    "tables": [
      {"name": "SourceDataTable", "sheet": "Source_Data", "range": "A4:H29", "minimum_rows": 1, "maximum_rows": 25, "columns": {"Source Row ID": "nonempty_string", "Entity Code": "nonempty_string", "Account Code": "nonempty_string", "Transaction Date": "date", "Description": "string", "Debit": "decimal", "Credit": "decimal", "Status Code": "string"}},
      {"name": "AccountMapTable", "sheet": "Account_Map", "range": "A4:E29", "minimum_rows": 1, "maximum_rows": 25, "columns": {"Account Code": "nonempty_string", "Account Name": "nonempty_string", "Statement Group": "string", "Reconciliation Owner Role": "role", "Active?": "enum:Yes|No"}},
      {"name": "ReconciliationTable", "sheet": "Reconciliation", "range": "A4:H24", "minimum_rows": 1, "maximum_rows": 20, "columns": {"Account Code": "nonempty_string", "Account Name": "string", "Source Net": "formula", "Ledger Balance": "decimal", "Difference": "formula", "Threshold": "nonnegative_decimal", "Status": "formula", "Explanation / Action": "string"}},
      {"name": "ProposedEntriesTable", "sheet": "Proposed_Entries", "range": "A4:H19", "minimum_rows": 0, "maximum_rows": 15, "columns": {"Entry ID": "nonempty_string", "Account Code": "nonempty_string", "Description": "string", "Debit": "decimal", "Credit": "decimal", "Source Reference": "string", "Preparation Status": "enum:Draft|Ready for review|Hold", "Review Note": "string"}},
      {"name": "PriorPeriodTable", "sheet": "Prior_Period", "range": "A4:E24", "minimum_rows": 0, "maximum_rows": 20, "columns": {"Account Code": "nonempty_string", "Current Balance": "decimal", "Prior Balance": "decimal", "Change": "formula", "Context Note": "string"}},
      {"name": "ExceptionsTable", "sheet": "Exceptions", "range": "A4:H19", "minimum_rows": 0, "maximum_rows": 15, "columns": {"Exception ID": "nonempty_string", "Detected In": "string", "Question / Condition": "string", "Authority Class": "enum:supporting|contextual|question-only|superseded", "Owner Role": "role", "Due Date": "date", "Status": "enum:Open|Resolved|Retained", "Resolution Reference": "string"}}
    ]
  },
  "render_contract": {
    "required": true,
    "evidence_manifest": "evidence/reports/template-assets/render-manifest.json",
    "expected_page_count": 8,
    "expected_sheet_names": ["Close_Control", "Source_Data", "Account_Map", "Reconciliation", "Proposed_Entries", "Prior_Period", "Exceptions", "Checks"],
    "print_policy": "one_readable_candidate_page_per_bounded_sheet; capacity changes require rebuild and fresh evidence"
  },
  "knowledge_and_authority_constraints": [
    "Source_Data contains source-owned rows, not conclusions.",
    "Questions and exceptions cannot supply their own resolutions.",
    "A PASS check is internal arithmetic evidence, not approval or release authority.",
    "Current authoritative records control over prior-period context."
  ],
  "prohibited_content": ["prior submission bytes or facts", "real identities", "signatures or approvals", "hidden answer keys", "private grading or generator residue", "broken or pasted-over formulas", "unresolved build tokens in instantiated artifacts"],
  "supported_consumers": ["anna", "holodeck-file-generation", "human-artifact-realism"],
  "capabilities": ["native_xlsx", "transaction_population", "account_mapping", "formula_reconciliation", "proposed_entries", "prior_period_context", "exception_log", "control_checks", "renderable"],
  "generation_notes": [
    "Populate source and mapping layers before reconciliation.",
    "Reject populations above a declared table maximum; a larger capacity requires a rebuilt workbook, extended formulas and tables, and fresh render evidence.",
    "Preserve formulas, validations, number formats, freeze panes, and distinct layer styling.",
    "The untouched candidate intentionally shows MODEL STATUS FAIL until required identity slots are replaced."
  ],
  "proof_expectations": [
    {"id": "xlsx-structure", "capability": "native_structure", "required": true, "description": "Open as OOXML and verify all eight named sheets."},
    {"id": "xlsx-recalculate", "capability": "formula_recalculation", "required": true, "description": "Recalculate and tie source, reconciliation, entries, and checks."},
    {"id": "xlsx-render", "capability": "render_all_sheets", "required": true, "description": "Render and visually inspect every sheet."},
    {"id": "xlsx-leakage", "capability": "metadata_and_content_scan", "required": true, "description": "Reject identities, world facts, generator residue, hidden answers, and unresolved tokens in an instantiated artifact."}
  ]
}
